# Assignment: My Shopping List Manager

# -------------------------------------------------------------
# STEP 1: Create a text file and write the initial shopping list
# -------------------------------------------------------------
print("--- Step 1: Creating file and writing initial list ---")
initial_items = ["Apples\n", "Milk\n", "Bread\n"]

# Opening in 'w' mode creates a new file or overwrites an existing one
with open("shopping_list.txt", "w") as file:
    file.writelines(initial_items)
print("Initial shopping list saved successfully.\n")


# -------------------------------------------------------------
# STEP 2: Read and display the complete file
# -------------------------------------------------------------
print("--- Step 2: Reading the complete file at once ---")

# Opening in 'r' mode reads the file
with open("shopping_list.txt", "r") as file:
    content = file.read()
    print(content)


# -------------------------------------------------------------
# STEP 3: Append new items to the file
# -------------------------------------------------------------
print("--- Step 3: Appending new items ---")
new_items = ["Eggs\n", "Cheese\n"]

# Opening in 'a' mode appends content to the end of the file without deleting it
with open("shopping_list.txt", "a") as file:
    file.writelines(new_items)
print("New items added to the list.\n")


# -------------------------------------------------------------
# STEP 4: Read the updated file line by line
# -------------------------------------------------------------
print("--- Step 4: Reading the updated list line by line ---")

# Using a for-loop over the file object reads it line by line efficiently
with open("shopping_list.txt", "r") as file:
    line_number = 1
    for line in file:
        # strip() removes the newline character (\n) for cleaner printing
        print(f"Item {line_number}: {line.strip()}")
        line_number += 1
