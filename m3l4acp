import tkinter as tk
import random
import string

# --- Functions ---

def generate_password():
    # 1. Get the desired password length from the entry box
    try:
        password_length = int(length_entry.get())
    except ValueError:
        # If the student types letters instead of numbers, show an error
        result_label.config(text="Please enter a valid number!", fg="red")
        return

    if password_length < 4:
        result_label.config(text="Password must be at least 4 characters!", fg="red")
        return

    # 2. Collect pools of characters
    letters = string.ascii_letters  # a-z, A-Z
    digits = string.digits          # 0-9
    symbols = string.punctuation    # !, @, #, etc.
    
    all_characters = letters + digits + symbols

    # 3. Generate a random password
    # random.sample ensures a good mix; we use choices if length is longer than the pool
    password_list = random.choices(all_characters, k=password_length)
    password = "".join(password_list)

    # 4. Display the generated password in our UI
    result_label.config(text=f"Password: {password}", fg="green")


# --- UI Setup (Tkinter Grid & Padding) ---

# Create main window
root = tk.Tk()
root.title("Random Password Generator")
root.geometry("400x250")

# Instruction Label (Row 0)
instruction_label = tk.Label(root, text="Enter Password Length:", font=("Arial", 12))
instruction_label.grid(row=0, column=0, padx=10, pady=20, sticky="e")

# Input Entry Box (Row 0, Column 1)
length_entry = tk.Entry(root, font=("Arial", 12), width=10)
length_entry.grid(row=0, column=1, padx=10, pady=20, sticky="w")
length_entry.insert(0, "12") # Default value of 12 characters

# Generate Button (Row 1, spans across both columns)
generate_btn = tk.Button(root, text="Generate Password", font=("Arial", 12, "bold"), bg="#4CAF50", fg="white", command=generate_password)
generate_btn.grid(row=1, column=0, columnspan=2, padx=10, pady=10)

# Result Label (Row 2, spans across both columns)
result_label = tk.Label(root, text="Your password will appear here", font=("Arial", 11, "italic"), wraplength=350)
result_label.grid(row=2, column=0, columnspan=2, padx=10, pady=20)

# Start the application loop
root.mainloop()
