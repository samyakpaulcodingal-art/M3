# OPERATION 1: Writing a list of strings at once using writelines()
# =============================================================
print("--- Operation 1: Writing with writelines() ---")
lines_to_write = [
    "First line of our project.\n",
    "Second line of our project.\n",
    "Third line of our project.\n"
]

# Writing multiple lines from a list without needing a loop
with open("operations_demo.txt", "w") as file:
    file.writelines(lines_to_write)
print("Multiple lines written successfully using writelines().\n")


