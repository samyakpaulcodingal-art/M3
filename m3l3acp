# OPERATION 2: Understanding the File Cursor with tell() and seek()
# =============================================================
print("--- Operation 2: Tracking and moving the file cursor ---")

with open("operations_demo.txt", "r") as file:
    # file.tell() tells us where the cursor is currently sitting (measured in bytes)
    print(f"Initial cursor position: {file.tell()}") 
    
    # Let's read the first line
    first_line = file.readline()
    print(f"Read line: {first_line.strip()}")
    
    # See how the cursor moved forward after reading
    print(f"Cursor position after reading one line: {file.tell()}")
    
